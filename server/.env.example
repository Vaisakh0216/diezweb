# Copy to server/.env for local work. On Hostinger set these under Environment variables.

NODE_ENV=development
PORT=4000

# Signs login tokens: use a long random value (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
JWT_SECRET=change-me

# SQLite database file. Empty = server/edd.db.
# Production: a folder outside the app so redeploys keep the data, e.g. /home/<hostinger-username>/edd-data/edd.db
DB_PATH=

# Inspection team mailbox for "Open in email" (optional).
INSPECTION_TEAM_EMAIL=

# MongoDB Atlas (not used by the app yet: data is in SQLite until a migration)
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/diez_aml?retryWrites=true&w=majority
